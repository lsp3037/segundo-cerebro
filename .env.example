# Copie este arquivo para .env.local e preencha. Nunca coloque o .env.local no git.
# Variáveis que começam com NEXT_PUBLIC_ aparecem no navegador: só coloque nelas o que é público.

# ── Supabase ─────────────────────────────────────────────── (Fase 1)
# Painel do Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave secreta (sb_secret_...). Só o servidor usa. Necessária a partir da Fase 3.
SUPABASE_SECRET_KEY=

# ── Login fechado ────────────────────────────────────────── (Fase 1)
# E-mails que podem entrar, separados por vírgula.
ALLOWED_EMAILS=voce@gmail.com

# ── Google Agenda ────────────────────────────────────────── (Fase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave para criptografar os tokens do Google no banco (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Segredo que o pg_cron envia ao chamar /api/cron/* (texto aleatório longo). Também assina os avisos do Google.
CRON_SECRET=
# Endereço do app. No PC: http://localhost:3333 (sem avisos automáticos do Google).
# Na Vercel: https://segundo-cerebro-one-omega.vercel.app (precisa ser https para o Google avisar).
APP_URL=http://localhost:3333

# ── Gemini (IA) ──────────────────────────────────────────── (Fases 2 e 6)
GEMINI_API_KEY=
# Modelo principal e reserva (o reserva entra quando o principal está sobrecarregado).
# Em nov/2026, gemini-2.5-flash já não estava disponível para contas novas.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Telegram ─────────────────────────────────────────────── (Fase 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# ── Agente de Marketing ──────────────────────────────────── (Fase 4)
MARKETING_AGENT_URL=
MARKETING_AGENT_KEY=

# ── Gerenciador de O.S. (só leitura) ─────────────────────── (Fase 4)
# Lido pela API do Gerenciador (GET /api/v1/orders). Crie a chave em
# Gerenciador › Configurações › API marcando só "Consultar Ordens de Serviço" (orders:read).
OS_API_URL=https://trustcare-one.vercel.app
OS_API_KEY=
